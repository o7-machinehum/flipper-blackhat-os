Subject: [PATCH] drm/sun4i: dsi: set panel orientation before registration

The DSI panel attaches only after the DRM device is registered. Setting
its orientation from the panel's get_modes callback then creates and
attaches a property too late, triggering two DRM warnings.

Read the child panel's rotation at connector creation instead. This also
lets fbcon see the orientation before the late panel attach triggers its
initial modeset. The panel's existing orientation setter becomes a no-op.

Adapted for Linux 7.1 from Romain Tisserand's upstream proposal:
https://lore.kernel.org/all/20261101203406.1360656-1-romain.tisserand@gmail.com/

diff --git a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
--- a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
+++ b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
@@ -1047,6 +1047,27 @@ static const struct regmap_config sun6i_dsi_regmap_config = {
 	.name		= "mipi-dsi",
 };

+static int sun6i_dsi_set_panel_orientation(struct sun6i_dsi *dsi)
+{
+	enum drm_panel_orientation orientation;
+	int ret;
+
+	/* The panel driver cannot attach until after DRM registration. */
+	for_each_available_child_of_node_scoped(dsi->dev->of_node, np) {
+		if (of_node_name_eq(np, "port") || of_node_name_eq(np, "ports"))
+			continue;
+
+		ret = of_drm_get_panel_orientation(np, &orientation);
+		if (ret || orientation == DRM_MODE_PANEL_ORIENTATION_UNKNOWN)
+			continue;
+
+		return drm_connector_set_panel_orientation(&dsi->connector,
+							    orientation);
+	}
+
+	return 0;
+}
+
 static int sun6i_dsi_bind(struct device *dev, struct device *master,
 			 void *data)
 {
@@ -1075,6 +1096,12 @@ static int sun6i_dsi_bind(struct device *dev, struct device *master,
 		goto err_cleanup_connector;
 	}

+	ret = sun6i_dsi_set_panel_orientation(dsi);
+	if (ret) {
+		drm_connector_cleanup(&dsi->connector);
+		goto err_cleanup_connector;
+	}
+
 	drm_connector_attach_encoder(&dsi->connector, &dsi->encoder);

 	dsi->drm = drm;
