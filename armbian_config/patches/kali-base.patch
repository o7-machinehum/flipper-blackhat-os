diff --git a/lib/functions/general/apt-utils.sh b/lib/functions/general/apt-utils.sh
index 92bc24283..9a4237d22 100644
--- a/lib/functions/general/apt-utils.sh
+++ b/lib/functions/general/apt-utils.sh
@@ -6,6 +6,50 @@
 
 # tl;dr: this function will return the version and download URL of a package.
 # it is very naive, and will only look into a few repos across Debian/Ubuntu.
+function apt_find_kali_package_version_and_download_url_from_repo_index() {
+	declare sought_package_name="${1}"
+
+	: "${KALI_MIRROR:?KALI_MIRROR is not set}"
+	: "${ARCH:?ARCH is not set}"
+
+	declare first_letter_of_sought_package_name="${sought_package_name:0:1}"
+	declare mirror_with_slash="${KALI_MIRROR}"
+	[[ "${mirror_with_slash}" != */ ]] && mirror_with_slash="${mirror_with_slash}/"
+
+	declare packages_index_url="http://${mirror_with_slash}dists/${KALI_SUITE}/main/binary-${ARCH}/Packages.gz"
+	declare packages_index_file
+	packages_index_file="$(mktemp)"
+
+	curl --silent --show-error --location --max-time 20 "${packages_index_url}" -o "${packages_index_file}" || {
+		rm -f "${packages_index_file}"
+		display_alert "Could not download Kali package index" "${packages_index_url}" "warn"
+		return 1
+	}
+
+	found_package_filename="$({
+		gzip -dc "${packages_index_file}" | awk -v pkg="${sought_package_name}" '
+			BEGIN { in_pkg = 0 }
+			$1 == "Package:" { in_pkg = ($2 == pkg) }
+			in_pkg && $1 == "Filename:" { print $2; exit }
+		'
+	})"
+	rm -f "${packages_index_file}"
+
+	[[ -n "${found_package_filename}" ]] || {
+		display_alert "Could not find package filename for '${sought_package_name}' in Kali repo index" "${packages_index_url}" "warn"
+		return 1
+	}
+
+	found_package_down_url="http://${mirror_with_slash}${found_package_filename}"
+	found_package_filename="${found_package_filename##*/}"
+	found_package_version="$(echo "${found_package_filename}" | grep -oP '(?<=_)[^_]+(?=_)')"
+
+	display_alert "Found Kali package filename" "${found_package_filename}" "info"
+	display_alert "Found Kali package download url" "${found_package_down_url}" "debug"
+	display_alert "Found Kali upstream package version" "${found_package_version}" "info"
+	return 0
+}
